{
  "expo": {
    "name": "SereneSpace",
    "slug": "SereneSpace",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./src/assets/InfoIcon.png",
    "userInterfaceStyle": "light",
    "newArchEnabled": true,
    "splash": {
      "image": "./src/assets/dove-logo.png",
      "resizeMode": "contain",
      "backgroundColor": "#ffffff"
    },
    "ios": {
      "supportsTablet": true
    },
    "android": {
      "softwareKeyboardLayoutMode": "adjustResize",
      "adaptiveIcon": {
        "foregroundImage": "./src/assets/dove-logo.png",
        "backgroundColor": "#ffffff"
      },
      
      "package": "com.briha43.SereneSpace"
    },
    "web": {
      "favicon": "./assets/favicon.png"
    },
    "plugins": ["expo-font", "expo-asset", "expo-video"],
    "extra": {
      "eas": {
        "projectId": "f75f2d51-017a-4c3a-82bb-32d32feadd2e"
      }
    }
  }
}
